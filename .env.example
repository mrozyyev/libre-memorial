# ---------------------------------------------------------------------------
# LibreMemorial — environment variables
#
# Locally: copy this file to `.dev.vars` (for `npm run cf:dev`) or export the
# values in your shell. On Cloudflare Pages: Project → Settings → Variables.
# ---------------------------------------------------------------------------

# A fine-grained GitHub token with "Contents: Read and write" on the repo below.
# Required for writes (creating memorials, adding photos and stories).
GITHUB_TOKEN=

# The repository that stores memorial content, as "owner/repo".
# For the hosted site this is the same repo the Pages project builds from.
GITHUB_REPO=mrozyyev/libre-memorial

# Branch to commit to. Defaults to "main".
GITHUB_BRANCH=main

# Optional: a Cloudflare Pages deploy hook. Only needed if the Pages project is
# not connected directly to the Git repository (otherwise the push triggers the
# rebuild on its own).
DEPLOY_HOOK_URL=

# Optional but recommended on a public deployment: a Cloudflare Turnstile secret.
# When set, the creation form requires a valid token. Pair it with the public
# site key below so the widget renders.
TURNSTILE_SECRET=

# Public (build-time) Turnstile site key. Safe to expose; required only if
# TURNSTILE_SECRET is set.
PUBLIC_TURNSTILE_SITE_KEY=

# Optional: extra origins allowed to call the API (comma separated). Same-origin
# requests are always allowed.
ALLOWED_ORIGINS=
