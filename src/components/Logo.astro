---
/**
 * The project mark: a leaf inside a circle — remembrance that keeps growing.
 * Rendered inline so it inherits the current text colour.
 */
interface Props {
  class?: string;
  size?: number;
}
const { class: className = "h-7 w-7", size } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  role="img"
  aria-label="LibreMemorial"
>
  <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2" opacity="0.35"
  ></circle>
  <path
    d="M16 25.5c0-4.6.4-8 2.6-10.6 1.5-1.8 3.6-2.9 6-3.2-.3 6.6-2.2 11.3-7 13.4"
    fill="currentColor"
    opacity="0.9"
  ></path>
  <path
    d="M16 25.5c0-3.8-.3-6.6-2.2-8.8-1.2-1.5-2.9-2.4-4.9-2.7.3 5.5 1.9 9.4 5.8 11.1"
    fill="currentColor"
    opacity="0.55"
  ></path>
  <path d="M16 25.5V14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
  ></path>
</svg>
