---
import { SITE, NAV } from "@/lib/site";
import Logo from "./Logo.astro";
import GithubMark from "./icons/GithubMark.astro";
import { Heart, ShieldCheck, EyeOff } from "@lucide/astro";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-sand-200 bg-sand-50">
  <div class="container-page grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2 text-brand-700">
        <Logo class="h-7 w-7" />
        <span class="font-serif text-lg font-semibold text-ink">LibreMemorial</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-muted">
        Free memorial pages, forever. Open source, git-backed, and built to be cheap enough to run
        for the long haul.
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium text-ink-muted">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-sand-200 bg-paper px-2.5 py-1">
          <EyeOff class="h-3.5 w-3.5" /> No tracking
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-sand-200 bg-paper px-2.5 py-1">
          <ShieldCheck class="h-3.5 w-3.5" /> No ads
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-sand-200 bg-paper px-2.5 py-1">
          <Heart class="h-3.5 w-3.5" /> Always free
        </span>
      </div>
    </div>

    <nav aria-label="Pages">
      <h2 class="text-sm font-semibold text-ink">Pages</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-muted">
        <li><a class="hover:text-ink" href="/create">Create a memorial</a></li>
        <li><a class="hover:text-ink" href="/explore">Browse memorials</a></li>
        {
          NAV.map((item) => (
            <li><a class="hover:text-ink" href={item.href}>{item.label}</a></li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Project">
      <h2 class="text-sm font-semibold text-ink">Project</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-muted">
        <li>
          <a class="inline-flex items-center gap-1.5 hover:text-ink" href={SITE.repo}>
            <GithubMark class="h-4 w-4" /> Source code
          </a>
        </li>
        <li><a class="hover:text-ink" href="/how-it-works">How the storage works</a></li>
        <li><a class="hover:text-ink" href={`${SITE.repo}/blob/main/LICENSE`}>{SITE.license} license</a></li>
        <li><a class="hover:text-ink" href="/api/health">Service status</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-ink">Support the project</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-muted">
        There is no paid tier. If this was useful, a small contribution keeps the servers and the
        domain running.
      </p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          SITE.support.map((item) => (
            <li>
              <a class="font-medium text-brand-700 hover:text-brand-800" href={item.url}>
                {item.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-sand-200">
    <div
      class="container-page flex flex-col gap-2 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} LibreMemorial contributors · {SITE.license}</p>
      <p>
        Made with care. No accounts, no payments, no third-party scripts.
      </p>
    </div>
  </div>
</footer>
