---
import Layout from "@/layouts/Layout.astro";
import MemorialCard from "@/components/MemorialCard.astro";
import MemorialSearch from "@/components/islands/MemorialSearch.tsx";
import Button from "@/components/Button.astro";
import { getMemorials } from "@/lib/memorials";
import { pluralize } from "@/lib/format";
import { Images, ArrowRight } from "@lucide/astro";

const memorials = getMemorials();
---

<Layout
  title="Memorials"
  description="Browse the memorial pages hosted on LibreMemorial — each one with photographs, stories and a printable QR code."
>
  <section class="border-b border-sand-200 bg-sand-50">
    <div class="container-page py-16">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Memorials</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
        Lives remembered here
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Every page below is a real example of what families can build — photographs, the life story,
        memories shared by friends, and a QR code for the service.
      </p>
      {
        memorials.length > 0 && (
          <p class="mt-4 text-sm text-ink-muted">
            {pluralize(memorials.length, "public memorial", "public memorials")}
          </p>
        )
      }
    </div>
  </section>

  <section class="container-page py-14">
    {
      memorials.length === 0 ? (
        <div class="card-surface mx-auto max-w-xl p-10 text-center">
          <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
            <Images class="h-6 w-6" />
          </span>
          <h2 class="mt-5 font-serif text-2xl font-semibold text-ink">No memorials yet</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            Nothing has been published here so far. You could be the first — it takes a couple of
            minutes and costs nothing.
          </p>
          <div class="mt-6 flex justify-center">
            <Button href="/create">Create a memorial <ArrowRight class="h-4 w-4" /></Button>
          </div>
        </div>
      ) : (
        <>
          <MemorialSearch client:load />
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {memorials.map((entry) => (
              <li
                data-memorial
                data-search={`${entry.memorial.name} ${entry.memorial.location ?? ""} ${entry.memorial.epitaph ?? ""}`}
              >
                <MemorialCard entry={entry} />
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Layout>
