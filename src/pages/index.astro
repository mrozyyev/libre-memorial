---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import Support from "@/components/sections/Support.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import MemorialCard from "@/components/MemorialCard.astro";
import { getMemorials } from "@/lib/memorials";
import { SITE } from "@/lib/site";
import { ArrowRight } from "@lucide/astro";

const memorials = getMemorials();
const featured = memorials[0];
const recent = memorials.slice(0, 3);
---

<Layout title={`${SITE.name} — free memorial pages with QR codes`} description={SITE.description}>
  <Hero featured={featured} baseUrl={SITE.url} />
  <FeatureGrid />
  <HowItWorks />

  {
    recent.length > 0 && (
      <section class="container-page py-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Memorials</p>
            <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
              Lives remembered here
            </h2>
          </div>
          <a
            href="/explore"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            See all memorials <ArrowRight class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((entry) => (
            <MemorialCard entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  <Support />
  <CtaBand />
</Layout>
