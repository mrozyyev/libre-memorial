{
  "name": "libre-memorial",
  "version": "1.0.0",
  "description": "Free, open-source, git-backed memorial pages with QR codes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/generate-og.mjs",
    "start": "astro dev",
    "build": "astro check && tsc -p functions/tsconfig.json && astro build",
    "prebuild": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit && tsc -p functions/tsconfig.json",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@lucide/astro": "^1.49.0",
    "astro": "^7.3.5",
    "lucide-react": "^1.49.0",
    "oxc-transform-react": "^0.145.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
