{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "shared/**/*", "tests/**/*", "*.mjs"],
  "exclude": ["dist", "node_modules", "functions"]
}
